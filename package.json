{
  "dependencies": {
    "body-parser": "^2.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "nodemon": "^3.1.14",
    "save-dev": "^0.0.1-security"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
  "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
  "build": "tsc",
  "start": "node dist/server.js"
},
"compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
